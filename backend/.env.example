# Lancement du backend HORS Docker (npm run dev, npm run dev:worker, npm run semer…), avec
# PostgreSQL, Redis et Mailpit du docker-compose.yml de la racine : cp .env.example .env
# Adapter les ports si POSTGRES_PORT, REDIS_PORT ou MAILPIT_PORT ont été changés.
# Avec `docker compose up`, ce fichier n'est pas nécessaire : docker-compose.yml fournit tout.

# Propriétaire des tables : utilisé par « prisma migrate » uniquement
DATABASE_URL="postgresql://reclamations:reclamations@localhost:5432/reclamations_dev?schema=public"

# Rôle de connexion de l'application : aucun droit propre, soumis à la Row-Level Security
APP_DATABASE_URL="postgresql://reclamations_app:reclamations_app@localhost:5432/reclamations_dev?schema=public"

# Files d'attente BullMQ, limites de débit, idempotence
REDIS_URL="redis://localhost:6379"

# Secrets de DÉVELOPPEMENT : l'API refuse de démarrer avec ces valeurs en production
JWT_SECRET="developpement-uniquement-changer-en-production-0123456789"
# 32 octets (64 caractères hexadécimaux ou base64) : chiffre les secrets TOTP du personnel
CLE_CHIFFREMENT_TOTP="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
# Clé HMAC des codes à usage unique envoyés aux clients
CLE_OTP="developpement-uniquement-cle-otp-0123456789abcdef"

# WhatsApp et SMS entrant (étape 20) : envoi écrit dans le journal du worker ; secrets de développement
# des webhooks (npm run canal simule un message signé)
WHATSAPP_ENVOI=journal
WHATSAPP_SECRET_APP="developpement-whatsapp-secret-0123456789"
WHATSAPP_JETON_VERIFICATION="developpement-verification"
SMS_ENTRANT_SECRET="developpement-sms-entrant-0123456789"

# Antivirus des pièces jointes (étape 22) : aucun = fichiers acceptés sans analyse (développement
# seulement, refusé en production) ; clamav = démon clamd (docker compose --profile antivirus up -d clamav)
ANTIVIRUS=aucun
CLAMAV_HOTE=localhost
CLAMAV_PORT=3310

# Cookie du refresh token sans l'attribut Secure : nécessaire en http://localhost seulement
COOKIE_SECURE=false

# E-mails : Mailpit (http://localhost:8025 pour les lire)
SMTP_URL="smtp://localhost:1025"

# Port de l'API (http://localhost:3000/api/docs)
PORT=3000
# Adresses des écrans dans les e-mails et SMS (serveurs Vite de développement)
URL_CONSOLE="http://localhost:5173"
URL_PORTAIL="http://{slug}.localhost:5174"

# Facultatif — valeurs par défaut entre parenthèses
# DOMAINE_PLATEFORME=reclamations.example   (adresses des liens envoyés : console.<domaine>, <slug>.<domaine>)
# STOCKAGE_DOSSIER=var/fichiers             (pièces jointes et logos)
# VALIDER_REPONSES=true                     (chaque réponse vérifiée contre le contrat hors production)
# ANTI_ROBOT_MAXIMUM=100000                 (difficulté de base de l'anti-robot du portail, étape 11)
# IA_FOURNISSEUR=regles                     (assistant IA, étape 18 : regles, anthropic, openai ou mistral)
# IA_MODELE=  IA_CLE=  IA_PRIX_ENTREE=0  IA_PRIX_SORTIE=0  IA_PLAFOND_JOUR=2000
# BANC_ANTHROPIC_CLE=  BANC_OPENAI_CLE=  BANC_MISTRAL_CLE=   (banc d'essai : npm run banc-ia)
