# Base PostgreSQL du conteneur Docker (voir docker-compose.yml à la racine).
# Adapter les ports si POSTGRES_PORT ou REDIS_PORT ont été changés.

# Propriétaire des tables : utilisé par « prisma migrate » uniquement
DATABASE_URL="postgresql://reclamations:reclamations@localhost:5432/reclamations_dev?schema=public"

# Rôle de connexion de l'application : aucun droit propre, soumis à la Row-Level Security
APP_DATABASE_URL="postgresql://reclamations_app:reclamations_app@localhost:5432/reclamations_dev?schema=public"

# Files d'attente BullMQ
REDIS_URL="redis://localhost:6379"
