# =============================================================================
#  Production (VPS Contabo) — ne jamais versionner. Le créer avec les secrets déjà générés :
#    ./deploiement/generer-env.sh --domaine <domaine> --acme <adresse>
#  puis compléter les valeurs vides. Secret fait à la main : openssl rand -hex 32 (pas de base64 :
#  « / », « + » et « = » casseraient les adresses de connexion postgresql://…).
# =============================================================================

# Version de l'image construite (étiquette libre, ex. 1.0.0)
VERSION=1.0.0

# Nom de domaine de la plateforme : console.<domaine> et <slug>.<domaine> (point ouvert n° 11)
# Les enregistrements DNS « console » et « * » doivent pointer vers le VPS.
DOMAINE_PLATEFORME=
# Adresse de contact Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# PostgreSQL : propriétaire des tables (migrations) et rôle de connexion de l'application
POSTGRES_USER=reclamations
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Secrets de l'application
JWT_SECRET=
# 32 octets en hexadécimal (64 caractères) : chiffre les secrets TOTP ; la perdre oblige à réenrôler tout le personnel
CLE_CHIFFREMENT_TOTP=
CLE_OTP=

# E-mails : prestataire transactionnel à choisir (point ouvert), ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
# (caractères spéciaux du mot de passe encodés : @ → %40, / → %2F, : → %3A)
SMTP_URL=
EMAIL_EXPEDITEUR=Réclamations <no-reply@exemple.ci>

# SMS (étape 9) : « journal » tant que la passerelle de Makor Telecoms n'est pas branchée (aucun SMS
# envoyé, le worker le signale au démarrage), puis « http » avec l'adresse et la clé de la passerelle
SMS_MODE=journal
SMS_URL=
SMS_CLE=
# Nom affiché sur le téléphone du client : 11 caractères au plus, sans accent
SMS_EXPEDITEUR=Reclamation

# Anti-robot du dépôt et de la demande de code (étape 11) : le navigateur cherche un nombre entre 0 et
# ce maximum, pendant la saisie (moins d'un dixième de seconde sur un ordinateur, moins d'une
# demi-seconde sur un téléphone d'entrée de gamme ; la difficulté monte d'elle-même, jusqu'à 16 fois,
# pour une adresse IP qui insiste). À relever en cas d'attaque.
ANTI_ROBOT_MAXIMUM=100000

# Assistant IA (étape 18) : « regles » tant qu'aucun fournisseur n'est choisi (rien n'est envoyé hors du
# serveur). Après le banc d'essai (docs/etape-18-assistant-ia.md) et l'accord de l'ARTCI pour le transfert :
# IA_FOURNISSEUR=anthropic, openai ou mistral, le modèle, la clé d'API et le tarif (dollars par million
# de jetons, pour le coût journalisé). IA_PLAFOND_JOUR : appels par banque et par jour, au-delà les règles.
IA_FOURNISSEUR=regles
IA_MODELE=
IA_CLE=
IA_PRIX_ENTREE=0
IA_PRIX_SORTIE=0
IA_PLAFOND_JOUR=2000

# WhatsApp Business et SMS entrant (étape 20, docs/etape-20-whatsapp-sms-entrant.md). Application de Makor
# chez Meta (fournisseur de technologie) : secret de l'application (signature des webhooks), jeton de
# vérification saisi chez Meta à l'abonnement de https://console.<domaine>/api/v1/webhooks/whatsapp.
# Vides : webhooks refusés (401). Les jetons des banques se saisissent dans la console (raccordement),
# chiffrés avec une clé dérivée de CLE_CHIFFREMENT_TOTP.
WHATSAPP_ENVOI=meta
WHATSAPP_SECRET_APP=
WHATSAPP_JETON_VERIFICATION=
# Secret partagé avec la passerelle SMS de Makor pour signer les SMS reçus (POST /api/v1/webhooks/sms)
SMS_ENTRANT_SECRET=

# ---- Sauvegardes (étape 10, docs/exploitation.md) -------------------------------------------------
# Clés PUBLIQUES age (age1…, une ou plusieurs séparées par des espaces), créées avec age-keygen sur un
# poste de confiance. Les clés privées ne vont jamais sur le VPS : sans elles, aucune restauration.
SAUVEGARDE_CLES_AGE=
# Heure de la sauvegarde quotidienne (UTC, l'heure d'Abidjan)
SAUVEGARDE_HEURE=02:30
# Copie hors du VPS : compartiment Contabo Object Storage dédié (de préférence dans une autre région
# que le VPS) et ses clés S3. Tant qu'il manque, chaque sauvegarde est signalée en échec.
# Le compartiment se crée avec « sauvegarder --preparer » (docs/exploitation.md), PAS dans le panneau
# Contabo : le verrouillage des copies ne s'active qu'à la création.
SAUVEGARDE_S3_ENDPOINT=https://eu2.contabostorage.com
SAUVEGARDE_S3_BUCKET=
SAUVEGARDE_S3_CLE=
SAUVEGARDE_S3_SECRET=
# Verrouillage des copies hors du VPS (étape 12) : COMPLIANCE = personne ne peut les effacer avant la
# fin de leur conservation, pas même avec les clés du VPS. GOVERNANCE (contournable avec les clés) ou
# « aucun » seulement si le compartiment ne le permet pas.
SAUVEGARDE_VERROU=COMPLIANCE
# Rétention : copies sur le VPS, jours de quotidiennes et mois de mensuelles hors du VPS
SAUVEGARDE_LOCALES=7
SAUVEGARDE_JOURS=30
SAUVEGARDE_MOIS=12
# Supervision « dead man's switch » : adresse de ping (healthchecks.io ou Uptime Kuma en mode push),
# appelée à chaque sauvegarde réussie, /fail en cas d'échec ; l'alerte part si rien n'arrive en 25 h
SAUVEGARDE_PING_URL=
