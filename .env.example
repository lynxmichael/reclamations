# Variables lues par docker-compose.yml (valeurs par défaut si absentes)

# Propriétaire des tables (migrations uniquement)
POSTGRES_USER=reclamations
POSTGRES_PASSWORD=reclamations
# Rôle de connexion de l'application (reclamations_app), créé au premier démarrage
APP_DB_PASSWORD=reclamations_app

# Changer si un port est déjà pris sur ta machine (ex. 5433, 6380)
POSTGRES_PORT=5432
REDIS_PORT=6379
