{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@domaine/*": [
        "../backend/src/domaine/*"
      ],
      "luxon": [
        "./node_modules/@types/luxon/index.d.ts"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "outils",
    "console/entree.ts",
    "portail/entree.ts",
    "tests/contrat.ts",
    "tests/navigateur",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
