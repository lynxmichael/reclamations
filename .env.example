# Variables lues par docker-compose.yml (valeurs par défaut si absentes) : cp .env.example .env
# La production a son propre modèle : .env.production.example

# Propriétaire des tables (migrations uniquement)
POSTGRES_USER=reclamations
POSTGRES_PASSWORD=reclamations
# Rôle de connexion de l'application (reclamations_app), créé au premier démarrage
APP_DB_PASSWORD=reclamations_app

# Changer si un port est déjà pris sur ta machine (ex. 5433, 6380, 3001)
POSTGRES_PORT=5432
REDIS_PORT=6379
# API et Swagger : http://localhost:3000/api/docs
API_PORT=3000
# E-mails de développement (Mailpit) : http://localhost:8025
MAILPIT_PORT=8025
# Écrans : console http://localhost:5173, portail http://<slug>.localhost:5174
CONSOLE_PORT=5173
PORTAIL_PORT=5174
# Documentation du contrat seule (profil « docs »)
SWAGGER_PORT=8081

# Antivirus ClamAV des pièces jointes (étape 22), comme en production : décommenter les deux lignes,
# puis docker compose up -d (premier démarrage : une à deux minutes, environ 1,3 Go de mémoire).
# Sans lui, les fichiers sont acceptés sans analyse (le journal de l'API le rappelle).
COMPOSE_PROFILES=antivirus
 ANTIVIRUS=clamav
