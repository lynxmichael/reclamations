// =============================================================================
//  Plateforme de gestion des réclamations — Makor Telecoms · Solution 1
//  Étape 2 · Modèle de données — 19 modèles, 13 énumérations
//  Référence : cahier des charges consolidé, sections 3 (arbitrages), 5, 6 et 9.
//  Cible : Prisma 7 (l'URL de connexion est dans prisma.config.ts), PostgreSQL 16.
// =============================================================================
//
//  Conventions
//  - Identifiants UUID v7 (triés dans le temps), type PostgreSQL uuid.
//  - Tables et colonnes en snake_case côté SQL (@map), noms Prisma en camelCase.
//  - Horodatages en timestamptz, stockés en UTC ; l'affichage suit le fuseau de la banque.
//  - Toute donnée d'une banque porte tenant_id (arbitrage 2). Exceptions assumées :
//      plan (donnée de la plateforme), session_utilisateur et jeton_utilisateur
//      (lus par empreinte avant que la banque ne soit connue, rattachés à l'utilisateur).
//  - À l'intérieur d'une banque, les clés étrangères sont composites (tenant_id, id) :
//    une réclamation de la banque A ne peut référencer ni la catégorie, ni l'agence,
//    ni le client, ni l'agent de la banque B, même en cas de bug applicatif
//    (les contrôles de clé étrangère ne passent pas par la Row-Level Security).
//  - Aucune suppression physique des comptes ni des réclamations : onDelete: Restrict partout.
//  - Les contraintes non exprimables en Prisma sont listées en fin de fichier (étape 3).
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // NestJS compile en CommonJS : imports en .js, résolus vers .ts par tsc et tsx
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
//  Énumérations (13)
// -----------------------------------------------------------------------------

/// Rôles du personnel (§5). Le client final n'est pas un utilisateur (arbitrage 1).
enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN_ENTREPRISE
  SUPERVISEUR
  AGENT

  @@map("role_utilisateur")
}

/// Cycle de vie d'un compte du personnel. DESACTIVE remplace la suppression.
enum StatutUtilisateur {
  INVITE
  ACTIF
  DESACTIVE

  @@map("statut_utilisateur")
}

/// Liens envoyés par e-mail au personnel.
enum TypeJeton {
  INVITATION
  REINITIALISATION

  @@map("type_jeton")
}

/// Canal de dépôt, porté par le point de dépôt (§6.1). Les canaux de la phase 2
/// (WhatsApp, SMS entrant, chat web) s'ajouteront ici.
enum CanalDepot {
  QR_CODE
  LIEN_WEB

  @@map("canal_depot")
}

/// Les 5 statuts du CDC (écart « Statuts », section 3).
enum StatutReclamation {
  OUVERTE
  EN_COURS
  EN_ATTENTE_CLIENT
  RESOLUE
  CLOTUREE

  @@map("statut_reclamation")
}

enum Priorite {
  NORMALE
  URGENTE

  @@map("priorite")
}

/// Comment une réclamation a été clôturée (arbitrage 5, §6.3).
enum ModeCloture {
  CONFIRMATION_CLIENT
  AUTOMATIQUE
  FORCEE

  @@map("mode_cloture")
}

/// Motif obligatoire d'une clôture forcée par un superviseur (§6.3).
enum MotifClotureForcee {
  DOUBLON
  HORS_PERIMETRE
  ABUS
  AUTRE

  @@map("motif_cloture_forcee")
}

/// Deux types de messages côté banque (§6.2) et le message du client.
enum TypeCommentaire {
  NOTE_INTERNE
  REPONSE_AU_CLIENT
  MESSAGE_DU_CLIENT

  @@map("type_commentaire")
}

/// Historique métier structuré (arbitrage 6). Les transitions reprennent le diagramme du §6.3.
enum TypeEvenement {
  CREATION
  PRISE_EN_CHARGE
  QUESTION_AU_CLIENT
  REPONSE_DU_CLIENT
  RESOLUTION
  CONFIRMATION
  CONTESTATION
  CLOTURE_AUTOMATIQUE
  CLOTURE_FORCEE
  ASSIGNATION
  CHANGEMENT_PRIORITE
  ESCALADE
  /// Second niveau d'escalade, vers l'Admin Entreprise (étape 16)
  ESCALADE_ADMIN
  ALERTE_SLA_PREVENTIVE
  DEPASSEMENT_SLA
  MESSAGE
  PIECE_JOINTE

  @@map("type_evenement")
}

/// Attribution des nouvelles réclamations (étape 16) : par le superviseur, suggérée, ou automatique.
enum ModeAttribution {
  MANUELLE
  SUGGESTION
  AUTOMATIQUE

  @@map("mode_attribution")
}

/// Canal d'une conversation (étape 17) : chat du portail ; WhatsApp et SMS entrant à l'étape 19.
enum CanalConversation {
  WEB
  WHATSAPP
  SMS

  @@map("canal_conversation")
}

/// Auteur d'une action : client final, membre du personnel ou tâche automatique.
enum TypeActeur {
  CLIENT
  UTILISATEUR
  SYSTEME

  @@map("type_acteur")
}

enum CanalNotification {
  EMAIL
  SMS
  IN_APP

  @@map("canal_notification")
}

enum StatutNotification {
  EN_ATTENTE
  ENVOYEE
  DELIVREE
  ECHEC

  @@map("statut_notification")
}

// -----------------------------------------------------------------------------
//  Plateforme
// -----------------------------------------------------------------------------

/// Offre commerciale. Le plafond d'agents bloque la création de comptes ; le plafond
/// de tickets ne bloque jamais un dépôt, son dépassement est signalé au Super Admin.
/// Un plafond vide signifie « illimité ».
model Plan {
  id                 String   @id @default(uuid(7)) @db.Uuid
  code               String   @unique @db.VarChar(40)
  nom                String   @db.VarChar(120)
  description        String?
  plafondAgents      Int?     @map("plafond_agents")
  plafondTicketsMois Int?     @map("plafond_tickets_mois")
  actif              Boolean  @default(true)
  creeLe             DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe          DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banques Banque[]

  @@map("plan")
}

/// Le tenant. Son identifiant est la valeur de tenant_id dans toutes les tables de la banque.
model Banque {
  id                        String    @id @default(uuid(7)) @db.Uuid
  nom                       String    @db.VarChar(160)
  /// Adresse du portail : https://<slug>.<domaine de la plateforme>
  slug                      String    @unique @db.VarChar(63)
  /// Préfixe des numéros de ticket, ex. SGCI → SGCI-2026-000042
  prefixeTickets            String    @unique @map("prefixe_tickets") @db.VarChar(10)
  planId                    String    @map("plan_id") @db.Uuid
  fuseauHoraire             String    @default("Africa/Abidjan") @map("fuseau_horaire") @db.VarChar(64)
  couleurPrimaire           String?   @map("couleur_primaire") @db.VarChar(7)
  couleurSecondaire         String?   @map("couleur_secondaire") @db.VarChar(7)
  /// Clé du logo dans le stockage objet
  logoCle                   String?   @map("logo_cle") @db.VarChar(255)
  emailContact              String?   @map("email_contact") @db.VarChar(254)
  /// Alerte préventive à ce pourcentage du délai cible (arbitrage 4)
  seuilAlerteSlaPourcent    Int       @default(75) @map("seuil_alerte_sla_pourcent")
  /// Clôture automatique après ce nombre de jours sans réaction (arbitrage 5)
  delaiClotureAutoJours     Int       @default(5) @map("delai_cloture_auto_jours")
  /// SMS à chaque changement de statut, ou seulement au dépôt et à la résolution (point ouvert n° 5)
  smsChaqueChangementStatut Boolean   @default(true) @map("sms_chaque_changement_statut")
  /// Enquête de satisfaction à la clôture (étape 15), activée par Makor banque par banque (décision I2)
  enqueteSatisfaction       Boolean   @default(false) @map("enquete_satisfaction")
  /// Attribution et escalade automatiques (étape 16), ouvertes par Makor banque par banque (décision I2)
  attributionAutomatique    Boolean         @default(false) @map("attribution_automatique")
  /// Réglé par l'Admin Entreprise quand la fonction est ouverte
  modeAttribution           ModeAttribution @default(MANUELLE) @map("mode_attribution")
  /// Escalade à l'Admin Entreprise à ce pourcentage du délai cible ; vide : pas de second niveau
  seuilEscaladeAdminPourcent       Int?     @map("seuil_escalade_admin_pourcent")
  /// Même seuil pour une réclamation urgente
  seuilEscaladeAdminUrgentPourcent Int?     @map("seuil_escalade_admin_urgent_pourcent")
  /// Chat web sur le portail (étape 17), ouvert par Makor banque par banque (décision I2)
  chatWeb                   Boolean   @default(false) @map("chat_web")
  suspendueLe               DateTime? @map("suspendue_le") @db.Timestamptz(3)
  motifSuspension           String?   @map("motif_suspension")
  creeLe                    DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe                 DateTime  @updatedAt @map("modifie_le") @db.Timestamptz(3)

  plan          Plan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  agences       Agence[]
  pointsDepot   PointDepot[]
  categories    Categorie[]
  horaires      HoraireOuvre[]
  joursFeries   JourFerie[]
  utilisateurs  Utilisateur[]
  clients       ClientFinal[]
  reclamations  Reclamation[]
  compteurs     CompteurNumero[]
  notifications Notification[]
  groupes       GroupeAgents[]
  absences      AbsenceAgent[]
  conversations Conversation[]

  @@index([planId])
  @@map("banque")
}

// -----------------------------------------------------------------------------
//  Organisation de la banque (paramétrage par l'Admin Entreprise, §6.7)
// -----------------------------------------------------------------------------

/// Agence de la banque (arbitrage 3) : permet le reporting par agence.
model Agence {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  nom       String   @db.VarChar(160)
  ville     String?  @db.VarChar(120)
  adresse   String?  @db.VarChar(255)
  active    Boolean  @default(true)
  /// Groupe d'agents qui traite les réclamations de l'agence (étape 16)
  groupeId  String?  @map("groupe_id") @db.Uuid
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque       Banque        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  groupe       GroupeAgents? @relation(fields: [tenantId, groupeId], references: [tenantId, id], onDelete: Restrict)
  pointsDepot  PointDepot[]
  reclamations Reclamation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("agence")
}

/// QR code affiché en agence ou lien placé sur le site / l'application de la banque.
/// Son code public suffit à identifier banque, agence et canal (§6.1).
model PointDepot {
  id        String     @id @default(uuid(7)) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  /// Nulle seulement pour un lien web non rattaché à une agence (un QR code a toujours une agence)
  agenceId  String?    @map("agence_id") @db.Uuid
  /// Code public aléatoire porté par le QR code ou le lien, unique sur la plateforme
  code      String     @unique @db.VarChar(16)
  canal     CanalDepot
  libelle   String     @db.VarChar(160)
  actif     Boolean    @default(true)
  creeLe    DateTime   @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime   @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque       Banque        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agence       Agence?       @relation(fields: [tenantId, agenceId], references: [tenantId, id], onDelete: Restrict)
  reclamations Reclamation[]

  @@unique([tenantId, id])
  @@index([tenantId, agenceId])
  @@map("point_depot")
}

/// Type de réclamation, avec priorité par défaut et délai cible (SLA, arbitrage 4).
model Categorie {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  nom               String   @db.VarChar(120)
  description       String?
  prioriteParDefaut Priorite @default(NORMALE) @map("priorite_par_defaut")
  /// Délai cible en minutes ouvrées ; copié sur le ticket à sa création
  delaiCibleMinutes Int      @map("delai_cible_minutes")
  ordre             Int      @default(0)
  active            Boolean  @default(true)
  /// Groupe d'agents spécialiste de la catégorie (étape 16)
  groupeId          String?  @map("groupe_id") @db.Uuid
  /// Seuils d'escalade à l'Admin Entreprise propres à la catégorie ; vides : ceux de la banque
  seuilEscaladeAdminPourcent       Int? @map("seuil_escalade_admin_pourcent")
  seuilEscaladeAdminUrgentPourcent Int? @map("seuil_escalade_admin_urgent_pourcent")
  creeLe            DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe         DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque       Banque        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  groupe       GroupeAgents? @relation(fields: [tenantId, groupeId], references: [tenantId, id], onDelete: Restrict)
  reclamations Reclamation[]

  @@unique([tenantId, id])
  @@unique([tenantId, nom])
  @@map("categorie")
}

/// Plage ouvrée d'un jour de la semaine, dans le fuseau de la banque.
/// Plusieurs plages par jour sont possibles (ex. 08:00–12:00 et 14:00–17:30).
model HoraireOuvre {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// 1 = lundi … 7 = dimanche (ISO 8601)
  jourSemaine Int      @map("jour_semaine")
  /// Minutes depuis minuit, ex. 480 = 08:00
  debutMinute Int      @map("debut_minute")
  finMinute   Int      @map("fin_minute")
  creeLe      DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe   DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque Banque @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, jourSemaine, debutMinute])
  @@map("horaire_ouvre")
}

/// Jour férié de la banque. « recurrent » répète la date chaque année (1er mai, 7 août…) ;
/// les fêtes à date mobile (Aïd el-Fitr, Tabaski, Maouloud) sont saisies chaque année.
model JourFerie {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  libelle   String   @db.VarChar(120)
  recurrent Boolean  @default(false)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque Banque @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, date])
  @@map("jour_ferie")
}

// -----------------------------------------------------------------------------
//  Personnel
// -----------------------------------------------------------------------------

/// Compte du personnel. Chaque compte appartient à une seule banque, sauf le Super Admin
/// (tenant_id vide si et seulement si SUPER_ADMIN : contrainte CHECK à l'étape 3).
model Utilisateur {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String?           @map("tenant_id") @db.Uuid
  role                RoleUtilisateur
  statut              StatutUtilisateur @default(INVITE)
  /// Normalisé en minuscules, unique sur la plateforme : la connexion ne dépend pas de la banque
  email               String            @unique @db.VarChar(254)
  nom                 String            @db.VarChar(120)
  prenom              String            @db.VarChar(120)
  telephone           String?           @db.VarChar(20)
  /// argon2id ; vide tant que l'invitation n'est pas acceptée
  motDePasseHash      String?           @map("mot_de_passe_hash") @db.VarChar(255)
  /// Secret TOTP chiffré en AES-256-GCM (clé hors base) ; la 2FA est obligatoire pour tout le personnel
  totpSecretChiffre   String?           @map("totp_secret_chiffre") @db.VarChar(255)
  totpActiveLe        DateTime?         @map("totp_active_le") @db.Timestamptz(3)
  /// Équipe : un agent est rattaché à un superviseur de la même banque
  superviseurId       String?           @map("superviseur_id") @db.Uuid
  echecsConnexion     Int               @default(0) @map("echecs_connexion")
  verrouilleJusquA    DateTime?         @map("verrouille_jusqu_a") @db.Timestamptz(3)
  derniereConnexionLe DateTime?         @map("derniere_connexion_le") @db.Timestamptz(3)
  desactiveLe         DateTime?         @map("desactive_le") @db.Timestamptz(3)
  /// Dernière réclamation reçue : départage les agents également chargés (étape 16)
  derniereAttributionLe DateTime?       @map("derniere_attribution_le") @db.Timestamptz(3)
  creeLe              DateTime          @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe           DateTime          @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque      Banque?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  superviseur Utilisateur?  @relation("Equipe", fields: [tenantId, superviseurId], references: [tenantId, id], onDelete: Restrict)
  agents      Utilisateur[] @relation("Equipe")

  sessions               SessionUtilisateur[]
  jetons                 JetonUtilisateur[]
  reclamationsAssignees  Reclamation[]          @relation("AgentAssigne")
  reclamationsEscaladees Reclamation[]          @relation("EscaladeeVers")
  reclamationsCloturees  Reclamation[]          @relation("ClotureePar")
  commentaires           Commentaire[]
  piecesJointes          PieceJointe[]
  evenements             ReclamationEvenement[]
  notifications          Notification[]
  groupes                GroupeAgentsMembre[]
  absences               AbsenceAgent[]

  @@unique([tenantId, id])
  @@index([tenantId, role, statut])
  @@index([tenantId, superviseurId])
  @@map("utilisateur")
}

/// Groupe d'agents (étape 16) : les agents qui reçoivent les réclamations de ses catégories et agences.
model GroupeAgents {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nom       String   @db.VarChar(120)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque     Banque               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membres    GroupeAgentsMembre[]
  categories Categorie[]
  agences    Agence[]

  @@unique([tenantId, id])
  @@unique([tenantId, nom])
  @@map("groupe_agents")
}

model GroupeAgentsMembre {
  tenantId      String @map("tenant_id") @db.Uuid
  groupeId      String @map("groupe_id") @db.Uuid
  utilisateurId String @map("utilisateur_id") @db.Uuid

  groupe      GroupeAgents @relation(fields: [tenantId, groupeId], references: [tenantId, id], onDelete: Cascade)
  utilisateur Utilisateur  @relation(fields: [tenantId, utilisateurId], references: [tenantId, id], onDelete: Restrict)

  @@id([groupeId, utilisateurId])
  @@index([tenantId, utilisateurId])
  @@map("groupe_agents_membre")
}

/// Absence d'un agent (étape 16), jours inclus, dans le fuseau de la banque : il ne reçoit pas de
/// réclamation pendant ces jours. Sans motif : la cause d'une absence (maladie…) ne regarde pas l'outil.
model AbsenceAgent {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  utilisateurId String   @map("utilisateur_id") @db.Uuid
  du            DateTime @db.Date
  au            DateTime @db.Date
  creeLe        DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)

  banque      Banque      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  utilisateur Utilisateur @relation(fields: [tenantId, utilisateurId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, utilisateurId, au])
  @@map("absence_agent")
}

/// Refresh token (seule son empreinte est stockée), avec rotation et révocation.
/// La réutilisation d'un jeton déjà remplacé révoque toute sa famille.
model SessionUtilisateur {
  id               String    @id @default(uuid(7)) @db.Uuid
  utilisateurId    String    @map("utilisateur_id") @db.Uuid
  famille          String    @db.Uuid
  /// SHA-256 du refresh token
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expireLe         DateTime  @map("expire_le") @db.Timestamptz(3)
  remplaceLe       DateTime? @map("remplace_le") @db.Timestamptz(3)
  revoqueLe        DateTime? @map("revoque_le") @db.Timestamptz(3)
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([utilisateurId])
  @@index([famille])
  @@map("session_utilisateur")
}

/// Lien d'invitation ou de réinitialisation, à usage unique (seule son empreinte est stockée).
model JetonUtilisateur {
  id            String    @id @default(uuid(7)) @db.Uuid
  utilisateurId String    @map("utilisateur_id") @db.Uuid
  type          TypeJeton
  /// SHA-256 du jeton envoyé par e-mail
  jetonHash     String    @unique @map("jeton_hash") @db.Char(64)
  expireLe      DateTime  @map("expire_le") @db.Timestamptz(3)
  utiliseLe     DateTime? @map("utilise_le") @db.Timestamptz(3)
  creeLe        DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([utilisateurId, type])
  @@map("jeton_utilisateur")
}

// -----------------------------------------------------------------------------
//  Clients finaux (arbitrage 1)
// -----------------------------------------------------------------------------

/// Client d'une banque, sans mot de passe : accès par lien de suivi et code OTP.
/// Une même personne cliente de deux banques correspond à deux clients distincts.
/// E-mail ou téléphone obligatoire (contrainte CHECK à l'étape 3).
model ClientFinal {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nom       String   @db.VarChar(160)
  /// Normalisé en minuscules
  email     String?  @db.VarChar(254)
  /// Format E.164, ex. +2250700000000
  telephone String?  @db.VarChar(20)
  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque        Banque         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reclamations  Reclamation[]
  codesOtp      CodeOtp[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([tenantId, telephone])
  @@map("client_final")
}

/// Code à usage unique envoyé par SMS ou e-mail ; seul son HMAC est stocké.
model CodeOtp {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  /// EMAIL ou SMS
  canal       CanalNotification
  /// Adresse ou numéro utilisé, figé au moment de l'envoi
  destination String            @db.VarChar(254)
  /// HMAC-SHA256 du code (clé serveur)
  codeHash    String            @map("code_hash") @db.Char(64)
  expireLe    DateTime          @map("expire_le") @db.Timestamptz(3)
  tentatives  Int               @default(0)
  utiliseLe   DateTime?         @map("utilise_le") @db.Timestamptz(3)
  creeLe      DateTime          @default(now()) @map("cree_le") @db.Timestamptz(3)

  client ClientFinal @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, clientId, creeLe])
  @@map("code_otp")
}

// -----------------------------------------------------------------------------
//  Réclamations
// -----------------------------------------------------------------------------

/// Le ticket : statut, priorité, SLA, indicateurs, jalons et clôture.
model Reclamation {
  id           String            @id @default(uuid(7)) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  /// PRÉFIXE-AAAA-NNNNNN, séquentiel par banque et par année (ex. SGCI-2026-000042)
  numero       String            @db.VarChar(32)
  /// Jeton aléatoire du lien de suivi : ouvre la chronologie seule, le détail exige le code OTP
  jetonSuivi   String            @unique @map("jeton_suivi") @db.VarChar(64)
  clientId     String            @map("client_id") @db.Uuid
  categorieId  String            @map("categorie_id") @db.Uuid
  pointDepotId String            @map("point_depot_id") @db.Uuid
  /// Agence du point de dépôt, ou choisie par le client (facultative)
  agenceId     String?           @map("agence_id") @db.Uuid
  /// Copié du point de dépôt, pour le reporting
  canal        CanalDepot
  description  String
  statut       StatutReclamation @default(OUVERTE)
  priorite     Priorite
  agentId      String?           @map("agent_id") @db.Uuid

  // Consentement recueilli au dépôt (conformité ARTCI)
  consentementLe      DateTime @map("consentement_le") @db.Timestamptz(3)
  consentementVersion String   @map("consentement_version") @db.VarChar(20)

  // SLA (arbitrage 4, §6.4) — calculé en minutes ouvrées
  /// Délai cible copié de la catégorie à la création : un changement de barème ne touche pas les tickets en cours
  delaiCibleMinutes         Int       @map("delai_cible_minutes")
  /// Échéance ; vide pendant la pause « En attente client », recalculée à la reprise
  echeanceSlaLe             DateTime? @map("echeance_sla_le") @db.Timestamptz(3)
  /// Instant de l'alerte préventive (seuil de la banque, 75 % par défaut) ; vide pendant la pause
  alertePreventiveLe        DateTime? @map("alerte_preventive_le") @db.Timestamptz(3)
  /// Minutes ouvrées restantes, figées à l'entrée en pause
  slaMinutesRestantes       Int?      @map("sla_minutes_restantes")
  slaSuspenduLe             DateTime? @map("sla_suspendu_le") @db.Timestamptz(3)
  /// Chaque alerte ne part qu'une fois
  alertePreventiveEnvoyeeLe DateTime? @map("alerte_preventive_envoyee_le") @db.Timestamptz(3)
  depassementSlaSignaleLe   DateTime? @map("depassement_sla_signale_le") @db.Timestamptz(3)
  /// Fixé à la résolution : résolue avant l'échéance (taux de respect du SLA)
  slaRespecte               Boolean?  @map("sla_respecte")

  // Escalade (manuelle par l'agent, ou au dépassement du SLA)
  escaladeeLe     DateTime? @map("escaladee_le") @db.Timestamptz(3)
  escaladeeVersId String?   @map("escaladee_vers_id") @db.Uuid
  /// Second niveau : Admin Entreprise prévenu (étape 16), une seule fois
  escaladeeAdminLe DateTime? @map("escaladee_admin_le") @db.Timestamptz(3)

  // Jalons et indicateurs (§6.6)
  prisEnChargeLe              DateTime? @map("pris_en_charge_le") @db.Timestamptz(3)
  premiereReponseLe           DateTime? @map("premiere_reponse_le") @db.Timestamptz(3)
  /// Délai de première réponse, en minutes ouvrées
  delaiPremiereReponseMinutes Int?      @map("delai_premiere_reponse_minutes")
  resolueLe                   DateTime? @map("resolue_le") @db.Timestamptz(3)
  /// Délai de résolution, en minutes ouvrées (dernière résolution)
  delaiResolutionMinutes      Int?      @map("delai_resolution_minutes")
  /// Résolution au premier contact = aucune attente client, aucune escalade, aucune réouverture (arbitrage 6)
  passeEnAttenteClient        Boolean   @default(false) @map("passe_en_attente_client")
  nbReouvertures              Int       @default(0) @map("nb_reouvertures")

  // Clôture (arbitrage 5, §6.3)
  /// Date de clôture automatique si le client ne réagit pas ; vide hors statut RESOLUE
  clotureAutoPrevueLe DateTime?           @map("cloture_auto_prevue_le") @db.Timestamptz(3)
  clotureLe           DateTime?           @map("cloture_le") @db.Timestamptz(3)
  modeCloture         ModeCloture?        @map("mode_cloture")
  motifClotureForcee  MotifClotureForcee? @map("motif_cloture_forcee")
  /// Précision obligatoire pour une clôture forcée
  commentaireCloture  String?             @map("commentaire_cloture")
  clotureParId        String?             @map("cloture_par_id") @db.Uuid

  creeLe    DateTime @default(now()) @map("cree_le") @db.Timestamptz(3)
  modifieLe DateTime @updatedAt @map("modifie_le") @db.Timestamptz(3)

  banque        Banque       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client        ClientFinal  @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  categorie     Categorie    @relation(fields: [tenantId, categorieId], references: [tenantId, id], onDelete: Restrict)
  pointDepot    PointDepot   @relation(fields: [tenantId, pointDepotId], references: [tenantId, id], onDelete: Restrict)
  agence        Agence?      @relation(fields: [tenantId, agenceId], references: [tenantId, id], onDelete: Restrict)
  agent         Utilisateur? @relation("AgentAssigne", fields: [tenantId, agentId], references: [tenantId, id], onDelete: Restrict)
  escaladeeVers Utilisateur? @relation("EscaladeeVers", fields: [tenantId, escaladeeVersId], references: [tenantId, id], onDelete: Restrict)
  cloturePar    Utilisateur? @relation("ClotureePar", fields: [tenantId, clotureParId], references: [tenantId, id], onDelete: Restrict)

  commentaires  Commentaire[]
  piecesJointes PieceJointe[]
  evenements    ReclamationEvenement[]
  notifications Notification[]
  enquete       EnqueteSatisfaction?
  conversation  Conversation?

  @@unique([tenantId, id])
  @@unique([tenantId, numero])
  // Files de traitement (§6.2) et tableau de bord (§6.6)
  @@index([tenantId, statut, creeLe])
  @@index([tenantId, agentId, statut])
  @@index([tenantId, priorite, statut])
  @@index([tenantId, escaladeeVersId, statut])
  @@index([tenantId, clientId, creeLe])
  @@index([tenantId, agenceId, creeLe])
  @@index([tenantId, categorieId, creeLe])
  @@index([tenantId, canal, creeLe])
  // Tâches planifiées des workers (alertes SLA, clôture automatique)
  @@index([statut, alertePreventiveLe])
  @@index([statut, echeanceSlaLe])
  @@index([statut, clotureAutoPrevueLe])
  @@map("reclamation")
}

/// Séquence des numéros de ticket, par banque et par année (année civile dans le fuseau de la banque).
model CompteurNumero {
  tenantId String @map("tenant_id") @db.Uuid
  annee    Int
  dernier  Int    @default(0)

  banque Banque @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, annee])
  @@map("compteur_numero")
}

/// Note interne, réponse au client ou message du client. Immuable : une correction
/// se fait par un nouveau message (trigger à l'étape 3).
model Commentaire {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  reclamationId       String          @map("reclamation_id") @db.Uuid
  type                TypeCommentaire
  contenu             String
  /// Vide pour un message du client (l'auteur est alors le client de la réclamation)
  auteurUtilisateurId String?         @map("auteur_utilisateur_id") @db.Uuid
  creeLe              DateTime        @default(now()) @map("cree_le") @db.Timestamptz(3)

  reclamation       Reclamation   @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)
  auteurUtilisateur Utilisateur?  @relation(fields: [tenantId, auteurUtilisateurId], references: [tenantId, id], onDelete: Restrict)
  piecesJointes     PieceJointe[]

  @@unique([tenantId, id])
  @@index([tenantId, reclamationId, creeLe])
  @@map("commentaire")
}

/// Conversation avec le client d'une réclamation (étape 17, décision I8), commune à tous les canaux :
/// une par réclamation. Ses messages sont les commentaires publics de la réclamation (réponses de la
/// banque, messages du client) : SLA, chronologie, pièces jointes et immuabilité ne changent pas.
/// La conversation porte le canal, les marques de lecture et la présence du client.
model Conversation {
  id                     String            @id @default(uuid(7)) @db.Uuid
  tenantId               String            @map("tenant_id") @db.Uuid
  reclamationId          String            @map("reclamation_id") @db.Uuid
  /// Canal où le client a écrit en dernier ; la réponse de la banque y part (WhatsApp et SMS à l'étape 19)
  canal                  CanalConversation @default(WEB)
  creeLe                 DateTime          @default(now()) @map("cree_le") @db.Timestamptz(3)
  dernierMessageClientLe DateTime?         @map("dernier_message_client_le") @db.Timestamptz(3)
  dernierMessageBanqueLe DateTime?         @map("dernier_message_banque_le") @db.Timestamptz(3)
  /// Dernière lecture par le client, chat ouvert à l'écran : sert aussi à savoir s'il est en ligne
  luClientLe             DateTime?         @map("lu_client_le") @db.Timestamptz(3)
  /// Dernière lecture par l'agent assigné (par un superviseur si la réclamation n'est pas assignée)
  luBanqueLe             DateTime?         @map("lu_banque_le") @db.Timestamptz(3)
  /// Dernier avis (e-mail, SMS) d'une réponse restée non lue dans le chat
  avisClientLe           DateTime?         @map("avis_client_le") @db.Timestamptz(3)

  banque      Banque      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reclamation Reclamation @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, reclamationId])
  // Boîte de réception des agents
  @@index([tenantId, dernierMessageClientLe])
  // Avis différés au client (worker)
  @@index([dernierMessageBanqueLe])
  @@map("conversation")
}

/// Fichier joint (image ou PDF, 5 au plus au dépôt), avec empreinte SHA-256.
/// Un fichier joint à une note interne n'est jamais visible du client.
model PieceJointe {
  id                     String     @id @default(uuid(7)) @db.Uuid
  tenantId               String     @map("tenant_id") @db.Uuid
  reclamationId          String     @map("reclamation_id") @db.Uuid
  /// Message auquel le fichier est joint ; vide pour les fichiers du dépôt
  commentaireId          String?    @map("commentaire_id") @db.Uuid
  nomFichier             String     @map("nom_fichier") @db.VarChar(255)
  typeMime               String     @map("type_mime") @db.VarChar(100)
  tailleOctets           Int        @map("taille_octets")
  /// Clé dans le stockage objet (disque local en développement, compatible S3 en production)
  cleStockage            String     @unique @map("cle_stockage") @db.VarChar(255)
  empreinteSha256        String     @map("empreinte_sha256") @db.Char(64)
  deposeParType          TypeActeur @map("depose_par_type")
  deposeParUtilisateurId String?    @map("depose_par_utilisateur_id") @db.Uuid
  creeLe                 DateTime   @default(now()) @map("cree_le") @db.Timestamptz(3)

  reclamation          Reclamation  @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)
  commentaire          Commentaire? @relation(fields: [tenantId, commentaireId], references: [tenantId, id], onDelete: Restrict)
  deposeParUtilisateur Utilisateur? @relation(fields: [tenantId, deposeParUtilisateurId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, reclamationId])
  @@index([tenantId, commentaireId])
  @@map("piece_jointe")
}

/// Historique métier structuré : alimente la chronologie du client et les indicateurs.
/// Distinct du journal d'audit, qui sert la sécurité. Immuable (trigger à l'étape 3).
model ReclamationEvenement {
  id                  String             @id @default(uuid(7)) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  reclamationId       String             @map("reclamation_id") @db.Uuid
  type                TypeEvenement
  /// Renseignés pour les événements qui changent le statut
  statutAvant         StatutReclamation? @map("statut_avant")
  statutApres         StatutReclamation? @map("statut_apres")
  acteurType          TypeActeur         @map("acteur_type")
  acteurUtilisateurId String?            @map("acteur_utilisateur_id") @db.Uuid
  /// L'événement apparaît dans la chronologie du client
  visibleClient       Boolean            @map("visible_client")
  /// Détails structurés : agent avant/après, priorité avant/après, motif, commentaire_id…
  donnees             Json?
  creeLe              DateTime           @default(now()) @map("cree_le") @db.Timestamptz(3)

  reclamation       Reclamation  @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)
  acteurUtilisateur Utilisateur? @relation(fields: [tenantId, acteurUtilisateurId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, reclamationId, creeLe])
  @@index([tenantId, type, creeLe])
  @@map("reclamation_evenement")
}

/// Enquête de satisfaction (étape 15) : ouverte à la clôture confirmée ou automatique d'une
/// réclamation, une seule par réclamation, pendant 7 jours. Une fois donnée, la réponse ne se
/// modifie plus (trigger). Le Super Admin n'en lit jamais le commentaire (arbitrage 7).
model EnqueteSatisfaction {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  reclamationId  String    @map("reclamation_id") @db.Uuid
  /// Ouverture : la clôture de la réclamation
  creeLe         DateTime  @default(now()) @map("cree_le") @db.Timestamptz(3)
  expireLe       DateTime  @map("expire_le") @db.Timestamptz(3)
  reponduLe      DateTime? @map("repondu_le") @db.Timestamptz(3)
  /// Satisfaction sur le traitement de la réclamation (CSAT), de 1 à 5
  note           Int?      @db.SmallInt
  /// Recommandation de la banque à un proche (NPS), de 0 à 10
  recommandation Int?      @db.SmallInt
  commentaire    String?   @db.VarChar(1000)

  reclamation Reclamation @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, reclamationId])
  @@index([tenantId, creeLe])
  @@map("enquete_satisfaction")
}

// -----------------------------------------------------------------------------
//  Notifications (§6.5)
// -----------------------------------------------------------------------------

/// Envoi e-mail, SMS ou in-app, journalisé avec statut, tentatives et segments SMS facturés.
/// tenant_id vide pour les notifications de la plateforme : les alertes au Super Admin
/// ne contiennent que des métadonnées (banque, numéro, catégorie, heure — arbitrage 7).
model Notification {
  id                        String             @id @default(uuid(7)) @db.Uuid
  tenantId                  String?            @map("tenant_id") @db.Uuid
  canal                     CanalNotification
  /// Gabarit utilisé, ex. reclamation.depot, sla.alerte_preventive, reclamation.urgente
  modele                    String             @db.VarChar(80)
  destinataireUtilisateurId String?            @map("destinataire_utilisateur_id") @db.Uuid
  destinataireClientId      String?            @map("destinataire_client_id") @db.Uuid
  /// Adresse e-mail ou numéro, figé au moment de l'envoi ; vide pour l'in-app
  destination               String?            @db.VarChar(254)
  reclamationId             String?            @map("reclamation_id") @db.Uuid
  sujet                     String?            @db.VarChar(255)
  contenu                   String
  statut                    StatutNotification @default(EN_ATTENTE)
  tentatives                Int                @default(0)
  derniereErreur            String?            @map("derniere_erreur")
  /// Identifiant renvoyé par le prestataire e-mail ou la passerelle SMS
  idFournisseur             String?            @map("id_fournisseur") @db.VarChar(128)
  /// Segments SMS facturés, pour la refacturation par banque
  segmentsSms               Int?               @map("segments_sms")
  /// Empêche un double envoi (ex. sla.alerte_preventive:<réclamation>:<destinataire>)
  cleDeduplication          String?            @unique @map("cle_deduplication") @db.VarChar(200)
  envoyeeLe                 DateTime?          @map("envoyee_le") @db.Timestamptz(3)
  /// Lecture d'une notification in-app
  lueLe                     DateTime?          @map("lue_le") @db.Timestamptz(3)
  creeLe                    DateTime           @default(now()) @map("cree_le") @db.Timestamptz(3)

  banque                  Banque?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  destinataireUtilisateur Utilisateur? @relation(fields: [destinataireUtilisateurId], references: [id], onDelete: Restrict)
  destinataireClient      ClientFinal? @relation(fields: [tenantId, destinataireClientId], references: [tenantId, id], onDelete: Restrict)
  reclamation             Reclamation? @relation(fields: [tenantId, reclamationId], references: [tenantId, id], onDelete: Restrict)

  @@index([destinataireUtilisateurId, canal, lueLe])
  @@index([statut, creeLe])
  @@index([tenantId, canal, creeLe])
  @@index([tenantId, reclamationId])
  @@map("notification")
}

// -----------------------------------------------------------------------------
//  Traçabilité (§6.8)
// -----------------------------------------------------------------------------

/// Piste d'audit en écriture seule, sans clé étrangère : elle survit à tout.
/// Une chaîne par banque (« banque:<uuid> ») et une pour la plateforme (« plateforme »),
/// pour que chaque Admin Entreprise puisse vérifier la sienne sans voir celles des autres.
/// chaine, rang, empreinte_precedente et empreinte sont posés par un trigger (étape 3) :
/// empreinte = SHA-256(empreinte_precedente || contenu canonique de la ligne).
/// Les données ne contiennent jamais le contenu d'une réclamation ni les coordonnées
/// d'un client : le Super Admin lit ce journal pour toutes les banques (arbitrage 7).
model JournalAudit {
  id                  BigInt     @id @default(autoincrement())
  chaine              String     @default(dbgenerated()) @db.VarChar(48)
  rang                BigInt     @default(dbgenerated())
  tenantId            String?    @map("tenant_id") @db.Uuid
  horodatage          DateTime   @default(now()) @db.Timestamptz(6)
  acteurType          TypeActeur @map("acteur_type")
  acteurId            String?    @map("acteur_id") @db.Uuid
  /// Identité figée au moment de l'action (personnel seulement ; jamais le nom d'un client)
  acteurLibelle       String?    @map("acteur_libelle") @db.VarChar(255)
  acteurRole          String?    @map("acteur_role") @db.VarChar(40)
  /// ex. auth.connexion, reclamation.statut_modifie, parametrage.categorie_modifiee
  action              String     @db.VarChar(80)
  entite              String?    @db.VarChar(60)
  entiteId            String?    @map("entite_id") @db.VarChar(64)
  /// Avant / après, sans secret ni contenu de réclamation
  donnees             Json?
  ip                  String?    @db.VarChar(45)
  userAgent           String?    @map("user_agent") @db.VarChar(512)
  empreintePrecedente String     @default(dbgenerated()) @map("empreinte_precedente") @db.Char(64)
  empreinte           String     @unique @default(dbgenerated()) @db.Char(64)

  @@unique([chaine, rang])
  @@index([tenantId, horodatage])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// =============================================================================
//  Livré en SQL à l'étape 3 (non exprimable en Prisma)
// -----------------------------------------------------------------------------
//  Retenu par le CDC (§9)
//  1. CHECK utilisateur : (role = 'SUPER_ADMIN') = (tenant_id IS NULL).
//  2. CHECK client_final : email IS NOT NULL OR telephone IS NOT NULL.
//  3. Trigger journal_audit : chaîne SHA-256 par banque, UPDATE / DELETE interdits.
//  + Row-Level Security sur toutes les tables portant tenant_id (arbitrage 2).
//
//  Proposé en complément (à confirmer à l'étape 3)
//  4. CHECK point_depot : canal <> 'QR_CODE' OR agence_id IS NOT NULL (arbitrage 3).
//  5. CHECK reclamation : (statut = 'CLOTUREE') = (cloture_le IS NOT NULL) ;
//     mode_cloture = 'FORCEE' ⇒ motif_cloture_forcee et commentaire_cloture renseignés.
//  6. CHECK commentaire : (type = 'MESSAGE_DU_CLIENT') = (auteur_utilisateur_id IS NULL).
//  7. CHECK code_otp : canal IN ('EMAIL', 'SMS').
//  8. CHECK horaire_ouvre : jour_semaine 1–7, 0 <= debut_minute < fin_minute <= 1440.
//  9. CHECK banque : prefixe_tickets ~ '^[A-Z0-9]{2,10}$', seuil 1–99, délai de clôture >= 1.
// 10. Triggers d'immuabilité sur commentaire et reclamation_evenement.
// 11. Index partiels des workers (statuts actifs seulement).
// =============================================================================
