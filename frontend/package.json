{
  "name": "@reclamations/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plateforme de gestion des réclamations — portail client et console du personnel (React)",
  "scripts": {
    "dev": "vite",
    "dev:console": "vite --mode console",
    "dev:portail": "vite --mode portail",
    "dev:maquettes": "vite",
    "dev:demo": "vite --mode demo",
    "build:console": "vite build --mode console",
    "build:portail": "vite build --mode portail",
    "build:applications": "vite build --mode console && vite build --mode portail",
    "build:maquettes": "vite build",
    "build:demo": "vite build --mode demo",
    "build": "npm run build:applications && npm run build:maquettes && npm run build:demo",
    "contrat:types": "openapi-typescript ../contrat/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:navigateur": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
