{
  "name": "@reclamations/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme de gestion des réclamations — API NestJS et worker (Makor Telecoms, Solution 1)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --include ../contrat/openapi.yaml --env-file-if-exists=.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "semer": "tsx --env-file-if-exists=.env scripts/semer.ts",
    "totp": "tsx scripts/totp.ts",
    "super-admin": "tsx --env-file-if-exists=.env scripts/creer-super-admin.ts",
    "roles:dev": "tsx --env-file-if-exists=.env scripts/roles-developpement.ts",
    "serveur:navigateur": "tsx --env-file-if-exists=.env scripts/serveur-navigateur.ts",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "typecheck": "tsc --noEmit",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "contrat:verifier": "redocly lint ../contrat/openapi.yaml --config ../contrat/redocly.yaml",
    "contrat:types": "openapi-typescript ../contrat/openapi.yaml -o src/contrat/api.d.ts",
    "contrat:doc": "redocly build-docs ../contrat/openapi.yaml --config ../contrat/redocly.yaml -o ../docs/api/index.html",
    "banc-ia": "tsx --env-file-if-exists=.env scripts/banc-ia.ts",
    "verifier:integrite": "tsx scripts/verifier-integrite.ts",
    "verifier:securite": "tsx scripts/verifier-securite.ts",
    "verifier:cycle-de-vie": "tsx scripts/verifier-cycle-de-vie.ts",
    "verifier": "npm run -s verifier:integrite && npm run -s verifier:securite && npm run -s verifier:cycle-de-vie",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.33.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@redocly/cli": "^2.54.3",
    "@types/luxon": "^3.7.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^18.0.3",
    "openapi-typescript": "^7.13.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
