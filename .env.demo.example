# =============================================================================
#  Environnement de démonstration (second serveur) — ne jamais versionner. Le créer avec :
#    ./deploiement/generer-env.sh --demo --domaine demo.<domaine> --acme <adresse>
#  puis compléter les valeurs vides. Secret fait à la main : openssl rand -hex 32 (pas de base64 :
#  « / », « + » et « = » casseraient les adresses de connexion postgresql://…).
# =============================================================================

# Version de l'image construite (étiquette libre, ex. 1.0.0)
VERSION=1.0.0

# Domaine de la démonstration, ex. demo.reclamations.ci : console.demo… et alpha.demo…, horizon.demo…
# Les enregistrements DNS « console.demo » et « *.demo » doivent pointer vers ce serveur.
DOMAINE_PLATEFORME=
# Adresse de contact Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# PostgreSQL : propriétaire des tables (migrations) et rôle de connexion de l'application
POSTGRES_USER=reclamations
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Secrets de l'application
JWT_SECRET=
# 32 octets en hexadécimal (64 caractères) : chiffre les secrets TOTP ; la perdre oblige à réenrôler tout le personnel
CLE_CHIFFREMENT_TOTP=
CLE_OTP=

# E-mails : prestataire transactionnel à choisir (point ouvert), ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
# (caractères spéciaux du mot de passe encodés : @ → %40, / → %2F, : → %3A)
SMTP_URL=
EMAIL_EXPEDITEUR=Réclamations <no-reply@exemple.ci>

# SMS (étape 9) : « journal » tant que la passerelle de Makor Telecoms n'est pas branchée (aucun SMS
# envoyé, le worker le signale au démarrage), puis « http » avec l'adresse et la clé de la passerelle
SMS_MODE=journal
SMS_URL=
SMS_CLE=
# Nom affiché sur le téléphone du client : 11 caractères au plus, sans accent
SMS_EXPEDITEUR=Reclamation

# Anti-robot du dépôt et de la demande de code (étape 11) : le navigateur cherche un nombre entre 0 et
# ce maximum, pendant la saisie (moins d'un dixième de seconde sur un ordinateur, moins d'une
# demi-seconde sur un téléphone d'entrée de gamme ; la difficulté monte d'elle-même, jusqu'à 16 fois,
# pour une adresse IP qui insiste). À relever en cas d'attaque.
ANTI_ROBOT_MAXIMUM=100000

# Assistant IA (étape 18) : « regles » tant qu'aucun fournisseur n'est choisi (rien n'est envoyé hors du
# serveur). Après le banc d'essai (docs/etape-18-assistant-ia.md) et l'accord de l'ARTCI pour le transfert :
# IA_FOURNISSEUR=anthropic, openai ou mistral, le modèle, la clé d'API et le tarif (dollars par million
# de jetons, pour le coût journalisé). IA_PLAFOND_JOUR : appels par banque et par jour, au-delà les règles.
IA_FOURNISSEUR=regles
IA_MODELE=
IA_CLE=
IA_PRIX_ENTREE=0
IA_PRIX_SORTIE=0
IA_PLAFOND_JOUR=2000

# ---- Démonstration (étape 10) ------------------------------------------------------------------
# Interrupteur lu par les scripts de deploiement/ (surcharge docker-compose.demo.yml)
DEMONSTRATION=1
# Mot de passe des comptes de démonstration (12 caractères au moins), connu de l'équipe commerciale
DEMO_MOT_DE_PASSE=
# Graine des secrets TOTP (openssl rand -hex 32) : les mêmes d'une remise à zéro à l'autre
DEMO_GRAINE_TOTP=
# Heure de la remise à zéro quotidienne (UTC), utilisée par reinitialiser-demo.sh --installer-cron
DEMO_HEURE=03:17

# Pas de sauvegarde en démonstration (service désactivé) ; valeur exigée par docker-compose.prod.yml
SAUVEGARDE_CLES_AGE=sans-objet-en-demonstration
